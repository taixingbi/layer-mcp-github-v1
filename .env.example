# Copy to .env (never commit .env)
GITHUB_TOKEN=
GITHUB_OWNER=your-github-user-or-org

# Synthesis: legacy (LLM gateway, default) or cursor_sdk (Cursor SDK Ask-style)
# SYNTH_ENGINE=legacy
# SYNTH_ENGINE=cursor_sdk
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
# CURSOR_RUNTIME_CWD=/tmp

# LLM gateway — POST {LLM_GATEWAY_BASE_URL}/v1/chat/completions (SYNTH_ENGINE=legacy)
LLM_GATEWAY_BASE_URL=http://192.168.86.179:30180
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Max chars for github_search user message (fit vLLM --max-model-len 2048 + LLM_MAX_TOKENS)
LLM_USER_BODY_MAX_CHARS=4000
# Cap completion length for github_search answers (~120 words at 384; raise if answers truncate)
LLM_MAX_TOKENS=384
LLM_TEMPERATURE=0.5
# LLM_FOLLOW_UP_MAX_TOKENS=256
# Second LLM call for follow_up_questions (default off — saves latency)
# GITHUB_SEARCH_FOLLOW_UPS=true
# Latency: parallel GitHub fetch + README cache + question-based repo routing
# GITHUB_FETCH_WORKERS=8
# GITHUB_README_CACHE_TTL_SEC=3600
# GITHUB_REPO_ROUTING=true
# GITHUB_ROUTE_MAX_REPOS=5
# MCP tool defaults (optional; tools can pass ids per call — see docs/schema.md)
# LLM_CONVERSATION_ID=conv_github_001
# LLM_REQUEST_ID=request-id-1
# LLM_SESSION_ID=session-id-1
# LLM_TRACE_ID=trace-id-1
# LLM_API_KEY=

# MCP streamable-http (python -m app.main --http or Docker)
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
